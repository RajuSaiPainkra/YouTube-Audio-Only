{
    "manifest_version": 3,
    "name": "YouTube Audio Only",
    "description": "Play only the audio of YouTube videos and download audio.",
    "version": "1.0",
    "permissions": [
      "activeTab",
      "downloads"
    ],
    "background": {
      "service_worker": "background.js"
    },
    "action": {
      "default_popup": "popup.html",
      "default_icon": {
        "16": "images/icon16.png",
        "48": "images/icon48.png",
        "128": "images/icon128.png"
      }
    },
    "content_scripts": [
      {
        "matches": ["https://www.youtube.com/*"],
        "js": ["content.js"]
      }
    ],
    "host_permissions": [
      "https://www.youtube.com/*"
    ]
  }
  